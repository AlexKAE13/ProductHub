# Скопируйте в .env и заполните. Файл .env в репозиторий не кладется.
PRODUCTHUB_DB_PASSWORD=поменяйте-этот-пароль
PRODUCTHUB_PORT=8080

# Вход через AD/LDAP (пока false - войти нельзя, включите после настройки)
PRODUCTHUB_LDAP_ENABLED=false
# Пример для OpenLDAP; для AD: filter (sAMAccountName={0}), login-attribute sAMAccountName, name-attribute displayName
PRODUCTHUB_LDAP_URL=ldap://ldap.example.local:389
PRODUCTHUB_LDAP_BASE=dc=example,dc=local
PRODUCTHUB_LDAP_MANAGER_DN=cn=hub-reader,dc=example,dc=local
PRODUCTHUB_LDAP_MANAGER_PASSWORD=
PRODUCTHUB_LDAP_USER_SEARCH_BASE=ou=people
PRODUCTHUB_LDAP_USER_SEARCH_FILTER=(uid={0})
PRODUCTHUB_LDAP_LOGIN_ATTRIBUTE=uid
PRODUCTHUB_LDAP_NAME_ATTRIBUTE=cn
PRODUCTHUB_LDAP_MAIL_ATTRIBUTE=mail
PRODUCTHUB_LDAP_GROUP_SEARCH_BASE=ou=groups
PRODUCTHUB_LDAP_GROUP_SEARCH_FILTER=(member={0})
